server {
    listen 80;
    server_name your-domain.com www.your-domain.com;

    root /var/www/hongxu-portfolio;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(css|js|png|jpg|jpeg|webp|svg|pdf)$ {
        expires 7d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }
}
